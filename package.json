{
  "name": "acm-tkmce-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "node scripts/seed.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --test 'tests/unit/*.test.mjs'",
    "dev:emu": "VITE_FIREBASE_EMULATORS=1 VITE_FIREBASE_PROJECT_ID=demo-acm-e2e vite --port 5174 --strictPort",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-acm-e2e \"node scripts/e2e-payments.mjs\"",
    "test:e2e:members": "firebase emulators:exec --only auth,firestore --project demo-acm-e2e \"node scripts/e2e-membership.mjs\"",
    "audit:mobile": "firebase emulators:exec --only auth,firestore --project demo-acm-e2e \"node scripts/mobile-audit.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-acm-rules \"node --test 'tests/rules/*.test.mjs'\""
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "firebase": "^10.12.5",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^11.3.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^0.417.0",
    "ogl": "^1.0.11",
    "postprocessing": "6.36.7",
    "razorpay": "^2.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.25.1",
    "three": "^0.167.1",
    "vercel": "^57.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "playwright": "^1.61.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "vite": "^5.3.5"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  }
}
