# Copy to .env and fill in. The VITE_* vars are the browser-safe config baked
# into the build. The non-VITE_ secrets below are used ONLY by the serverless
# functions in /api and must be set in the Vercel dashboard, never committed.

# ── Firebase (client) ────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Razorpay (payments) — see PAYMENTS.md ────────────────────
# Public key id; its presence switches the payment feature ON in the client.
VITE_RAZORPAY_KEY_ID=

# Server-only secrets (set these in Vercel → Settings → Environment Variables,
# NOT in a committed file):
#   RAZORPAY_KEY_ID=            same as VITE_RAZORPAY_KEY_ID
#   RAZORPAY_KEY_SECRET=        Razorpay key secret
#   FIREBASE_SERVICE_ACCOUNT=   full service-account JSON on one line
